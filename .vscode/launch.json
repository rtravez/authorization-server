{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "java",
      "name": "AuthServerApplication",
      "request": "launch",
      "mainClass": "com.rtravez.auth.server.AuthServerApplication",
      "projectName": "auth-server",
      "env": {
        "SPRING_PROFILES_ACTIVE": "dev",
        "SERVER_PORT": "8080",
        "SERVER_SERVLET_CONTEXT_PATH": "/authServices",
        "SPRING_DATASOURCE_URL": "jdbc:postgresql://localhost:5432/db_test",
        "SPRING_DATASOURCE_USERNAME": "postgres",
        "SPRING_DATASOURCE_PASSWORD": "admin",
        "SPRING_SECURITY_OAUTH2_RESOURCESERVER_JWT_ISSUER_URI": "http://localhost:8080/authServices"
      }
    }
  ]
}
